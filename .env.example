# Portfolio Environment Configuration

# GitHub API Token (optional)
# Provides higher rate limits for GitHub API calls (5000 requests/hour instead of 60)
# Leave blank to use unauthenticated requests
# To get a token: https://github.com/settings/tokens
# VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# Development Server Port
# Default: 5174
# VITE_PORT=5174

# Build Output Directory
# Default: dist
# VITE_BUILD_DIR=dist
